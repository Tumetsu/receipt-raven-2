{
  "name": "Receipt Raven",
  "short_name": "Receipt Raven",
  "description": "Turn receipt photos into ledger transactions",
  "start_url": "/upload",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#1d1a2e",
  "background_color": "#1d1a2e",
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ],
  "share_target": {
    "action": "/upload",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "file", "accept": ["image/*", "application/pdf"] }]
    }
  }
}
