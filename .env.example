# Copy to .env and adjust. The backend reads ../.env and backend/.env;
# docker compose passes this file to the app container.

# development | production | test
ENVIRONMENT=development
LOG_LEVEL=INFO

# JSON list of origins allowed to call the API cross-origin
CORS_ORIGINS=["http://localhost:5173"]

# --- Receipt analysis -------------------------------------------------------
# openrouter (default) | openai | mock (no API key, a fixed sample receipt)
AI_PROVIDER=mock
# Any OpenRouter model id that reads images, e.g. anthropic/claude-haiku-4.5
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Account for analysed receipts that no payee rule matches (optional)
# DEFAULT_SOURCE_ACCOUNT=Assets:Checking
# Payee rules: copy backend/config/payee-account-rules.example.json to
# backend/config/payee-account-rules.json and edit it.

# --- Ledger -----------------------------------------------------------------
# `make dev-ledger` runs the beancount service here
BEANCOUNT_SERVICE_URL=http://localhost:8100

# --- Storage ----------------------------------------------------------------
# Defaults suit development; the Docker image sets its own paths.
# DATABASE_URL=sqlite:///./data/receipts.db
# UPLOADS_DIR=./uploads
# Delete the oldest uploaded documents beyond this size, e.g. 1GB (optional)
# MAX_UPLOADS_DISK_SIZE=1GB
# CLEANUP_INTERVAL_HOURS=24

# Frontend: leave unset for same-origin /api (the default in dev and prod)
# VITE_API_URL=
